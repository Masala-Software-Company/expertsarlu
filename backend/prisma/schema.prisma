generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  SUPER_ADMIN
  ASSISTANT_MANAGER
  SUPPORT_CLIENT
  CAISSE_ADMIN
  PROTOCOLE
}

enum DossierStatut {
  BROUILLON
  EN_COURS
  VALIDE
  FACTURE_PAYE
  VERROUILLE
  ARCHIVE_SUPPRIME
}

enum TypeClient {
  PARTICULIER
  INSTITUTION
}

enum Priorite {
  NORMALE
  URGENTE
  CRITIQUE
}

enum ProspectStatut {
  NOUVEAU
  EN_DISCUSSION
  CONVERTI
  PERDU
}

enum TypeRendezVous {
  AMBASSADE
  HOPITAL
  NAVETTE
}

enum StatutRendezVous {
  PLANIFIE
  CONFIRME
  TERMINE
  ANNULE
}

enum TypeLigneCotation {
  NAVETTE
  TRANSFERT
  AMBULANCE
  ASSURANCE
  ACCOMPAGNATEUR
  FRAIS_ANNEXE
  FORFAIT_TRAITEMENT
}

enum StatutFacture {
  BROUILLON
  ENVOYE
  ACCEPTE
  PAYE
  ANNULE
}

enum MethodePaiement {
  ESPECES
  VIREMENT
  CARTE
  MOBILE_MONEY
  AUTRE
}

enum CategorieDocument {
  IDENTITE
  MEDICAL
  LOGISTIQUE
  FACTURATION
  AUTRE
}

enum TypeTacheLogistique {
  VISA
  NAVETTE
  VOL
  AUTRE
}

enum StatutTache {
  A_FAIRE
  EN_COURS
  TERMINE
  BLOQUE
}

enum StatutDeverrouillage {
  EN_ATTENTE
  APPROUVE
  REFUSE
  EXPIRE
}

enum StatutDemandeSuppression {
  EN_ATTENTE
  APPROUVE
  REFUSE
}

enum PreInscriptionStatut {
  NOUVEAU
  A_VERIFIER
  INFORMATIONS_INCOMPLETES
  VALIDE
  REJETE
  DOSSIER_CREE
}

enum TypeDocumentVoyage {
  PASSEPORT_ORDINAIRE
  PASSEPORT_DIPLOMATIQUE
  PASSEPORT_SERVICE
  PASSEPORT_OFFICIEL
  PASSEPORT_SPECIAL
  AUTRE
}

model User {
  id           String   @id @default(cuid())
  nom          String
  email        String   @unique
  hashPassword String   @map("hash_password")
  role         RoleName
  actif        Boolean  @default(true)
  photoProfil  String?  @map("photo_profil")
  creeLe       DateTime @default(now()) @map("cree_le")
  majLe        DateTime @updatedAt @map("maj_le")

  dossiersCrees           Dossier[]              @relation("DossierCreateur")
  dossiersValides         Dossier[]              @relation("DossierValidateur")
  dossiersSupprimes       Dossier[]              @relation("DossierSuppresseur")
  rendezVousAssignes      RendezVous[]
  tachesAssignees         TacheLogistique[]
  documentsUploades       DocumentGED[]
  facturesGenerees        Facture[]
  auditLogs               AuditLog[]
  demandesDeverrouillage  DemandeDeverrouillage[] @relation("Demandeur")
  demandesTraitees        DemandeDeverrouillage[] @relation("Traiteur")
  demandesSuppFacture     DemandeSuppressionFacture[] @relation("DemandeurSuppFacture")
  demandesSuppTraitees    DemandeSuppressionFacture[] @relation("TraiteurSuppFacture")
  notifications           Notification[]
  refreshTokens           RefreshToken[]
  communications          Communication[]
  preInscriptionsTraitees PreInscription[]      @relation("PreInscriptionTraiteur")

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @map("token_hash")
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  creeLe    DateTime @default(now()) @map("cree_le")
  revoque   Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Permission {
  id     String @id @default(cuid())
  module String
  action String
  role   RoleName

  @@unique([role, module, action])
  @@map("permissions")
}

model Dossier {
  id                      String        @id @default(cuid())
  numero                  String        @unique
  typeClient              TypeClient    @map("type_client")
  statut                  DossierStatut @default(BROUILLON)
  statutAvantSuppression  DossierStatut? @map("statut_avant_suppression")
  verrouille              Boolean       @default(false)
  destination             String?
  pathologie              String?
  budget                  Decimal?      @db.Decimal(12, 2)
  priorite                Priorite      @default(NORMALE)
  notes                   String?
  suiviToken              String?       @unique @map("suivi_token")
  postRetourStatut        String?       @map("post_retour_statut") // EN_ATTENTE | RENTRE | SUIVI | CLOS
  postRetourNotes         String?       @map("post_retour_notes")
  postRetourLe            DateTime?     @map("post_retour_le")
  creeParId               String        @map("cree_par_id")
  valideParId             String?       @map("valide_par_id")
  supprimeLe              DateTime?     @map("supprime_le")
  supprimeParId           String?       @map("supprime_par_id")
  partenaireId            String?       @map("partenaire_id")
  creeLe                  DateTime      @default(now()) @map("cree_le")
  majLe                   DateTime      @updatedAt @map("maj_le")

  creePar           User                    @relation("DossierCreateur", fields: [creeParId], references: [id])
  validePar         User?                   @relation("DossierValidateur", fields: [valideParId], references: [id])
  supprimePar       User?                   @relation("DossierSuppresseur", fields: [supprimeParId], references: [id])
  patient           Patient?
  accompagnateurs   Accompagnateur[]
  lignesCotation    LigneCotation[]
  calculAssurance   CalculAssurance?
  factures          Facture[]
  documents         DocumentGED[]
  tachesLogistique  TacheLogistique[]
  rendezVous        RendezVous[]
  demandesUnlock    DemandeDeverrouillage[]
  communications    Communication[]
  partenaire        Partenaire?             @relation(fields: [partenaireId], references: [id])
  preInscription    PreInscription?

  @@index([statut])
  @@index([creeParId])
  @@index([partenaireId])
  @@map("dossiers")
}

/// Séquence annuelle pour MED-YYYY-XXXX (évite les doublons concurrents)
model DossierSequence {
  annee  Int @id
  dernier Int @default(0)

  @@map("dossier_sequences")
}

model Patient {
  id                   String    @id @default(cuid())
  dossierId            String    @unique @map("dossier_id")
  partenaireId         String?   @map("partenaire_id")
  nom                  String
  prenom               String
  dateNaissance        DateTime? @map("date_naissance")
  nationalite          String?
  telephone            String?
  email                String?
  adresse              String?
  documentIdentite     String?   @map("document_identite")
  numeroPasseport      String?   @map("numero_passeport")
  numeroNational       String?   @map("numero_national")
  photoProfil          String?   @map("photo_profil")
  donneesComplementaires Json?   @map("donnees_complementaires")
  creeLe               DateTime  @default(now()) @map("cree_le")

  dossier    Dossier     @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  partenaire Partenaire? @relation(fields: [partenaireId], references: [id])

  @@index([partenaireId])
  @@index([email])
  @@index([numeroPasseport])
  @@map("patients")
}

model Accompagnateur {
  id        String   @id @default(cuid())
  dossierId String   @map("dossier_id")
  nom       String
  prenom    String
  lien      String?
  telephone String?
  creeLe    DateTime @default(now()) @map("cree_le")

  dossier Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@index([dossierId])
  @@map("accompagnateurs")
}

model Prospect {
  id            String         @id @default(cuid())
  nom           String
  prenom        String?
  telephone     String?
  email         String?
  sourceContact String?        @map("source_contact")
  statut        ProspectStatut @default(NOUVEAU)
  notes         String?
  creeLe        DateTime       @default(now()) @map("cree_le")
  majLe         DateTime       @updatedAt @map("maj_le")

  @@map("prospects")
}

model Partenaire {
  id           String   @id @default(cuid())
  nom          String
  nomNormalise String?  @unique @map("nom_normalise")
  pays         String?
  type         String?
  contact      String?
  email        String?
  telephone    String?
  adresse      String?
  fax          String?
  notes        String?
  logoChemin   String?  @map("logo_chemin")
  actif        Boolean  @default(true)
  creeLe       DateTime @default(now()) @map("cree_le")
  majLe        DateTime @default(now()) @updatedAt @map("maj_le")

  dossiers         Dossier[]
  patients         Patient[]
  preInscriptions  PreInscription[]

  @@map("partenaires")
}

/// Demandes de pré-enregistrement (portail public Vercel → API Expert)
model PreInscription {
  id                   String               @id @default(cuid())
  reference            String               @unique
  statut               PreInscriptionStatut @default(NOUVEAU)
  categorie            TypeClient
  partenaireId         String?              @map("partenaire_id")
  institutionSaisie    Json?                @map("institution_saisie")
  nom                  String
  prenom               String
  dateNaissance        DateTime?            @map("date_naissance")
  email                String?
  telephone            String?
  numeroPasseport      String?              @map("numero_passeport")
  numeroNational       String?              @map("numero_national")
  photoChemin          String?              @map("photo_chemin")
  passeportChemin      String?              @map("passeport_chemin")
  documentMedicalChemin String?             @map("document_medical_chemin")
  donnees              Json
  dossierId            String?              @unique @map("dossier_id")
  traiteParId          String?              @map("traite_par_id")
  traiteLe             DateTime?            @map("traite_le")
  motifRejet           String?              @map("motif_rejet")
  historique           Json?
  ipSoumission         String?              @map("ip_soumission")
  userAgent            String?              @map("user_agent")
  creeLe               DateTime             @default(now()) @map("cree_le")
  majLe                DateTime             @updatedAt @map("maj_le")

  partenaire Partenaire? @relation(fields: [partenaireId], references: [id])
  dossier    Dossier?    @relation(fields: [dossierId], references: [id])
  traitePar  User?       @relation("PreInscriptionTraiteur", fields: [traiteParId], references: [id])

  @@index([statut])
  @@index([categorie])
  @@index([partenaireId])
  @@index([creeLe])
  @@map("pre_inscriptions")
}

model RendezVous {
  id               String            @id @default(cuid())
  dossierId        String?           @map("dossier_id")
  type             TypeRendezVous
  dateHeure        DateTime          @map("date_heure")
  lieu             String?
  statut           StatutRendezVous  @default(PLANIFIE)
  notes            String?
  assigneAId       String?           @map("assigne_a_id")
  rappelJ1EnvoyeLe DateTime?         @map("rappel_j1_envoye_le")
  rappelJ0EnvoyeLe DateTime?         @map("rappel_j0_envoye_le")
  creeLe           DateTime          @default(now()) @map("cree_le")

  dossier  Dossier? @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  assigneA User?    @relation(fields: [assigneAId], references: [id])

  @@index([dossierId])
  @@index([dateHeure])
  @@map("rendez_vous")
}

model LigneCotation {
  id          String            @id @default(cuid())
  dossierId   String            @map("dossier_id")
  type        TypeLigneCotation
  description String
  montant     Decimal           @db.Decimal(12, 2)
  devise      String            @default("USD")
  quantite    Int               @default(1)
  creeLe      DateTime          @default(now()) @map("cree_le")

  dossier Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@index([dossierId])
  @@map("lignes_cotation")
}

model CalculAssurance {
  id           String   @id @default(cuid())
  dossierId    String   @unique @map("dossier_id")
  jours        Int
  tarifApplique Decimal @map("tarif_applique") @db.Decimal(8, 2)
  montantTotal Decimal  @map("montant_total") @db.Decimal(12, 2)
  creeLe       DateTime @default(now()) @map("cree_le")
  majLe        DateTime @updatedAt @map("maj_le")

  dossier Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@map("calculs_assurance")
}

model TarifBase {
  id        String   @id @default(cuid())
  cle       String   @unique
  libelle   String
  montant   Decimal  @db.Decimal(12, 2)
  devise    String   @default("USD")
  unite     String?
  reference String?  @unique
  actif     Boolean  @default(true)
  majLe     DateTime @updatedAt @map("maj_le")
  creeLe    DateTime @default(now()) @map("cree_le")

  @@map("tarifs_base")
}

model Facture {
  id               String        @id @default(cuid())
  numero           String        @unique
  dossierId        String        @map("dossier_id")
  type             String        @default("DEVIS") // DEVIS | FACTURE
  statut           StatutFacture @default(BROUILLON)
  montantTotal     Decimal       @map("montant_total") @db.Decimal(12, 2)
  devise           String        @default("USD")
  dateEncaissement DateTime?     @map("date_encaissement")
  genereParId      String        @map("genere_par_id")
  version          Int           @default(1)
  signeLe          DateTime?     @map("signe_le")
  signeParNom      String?       @map("signe_par_nom")
  signatureToken   String?       @unique @map("signature_token")
  pdfChemin        String?       @map("pdf_chemin")
  codeVerification String?       @map("code_verification")
  creeLe           DateTime      @default(now()) @map("cree_le")

  dossier   Dossier    @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  generePar User       @relation(fields: [genereParId], references: [id])
  paiements Paiement[]
  demandesSuppression DemandeSuppressionFacture[]

  @@index([dossierId])
  @@map("factures")
}

model DemandeSuppressionFacture {
  id           String                    @id @default(cuid())
  factureId    String                    @map("facture_id")
  demandeParId String                    @map("demande_par_id")
  traiteParId  String?                   @map("traite_par_id")
  motif        String
  statut       StatutDemandeSuppression  @default(EN_ATTENTE)
  creeLe       DateTime                  @default(now()) @map("cree_le")
  traiteLe     DateTime?                 @map("traite_le")

  facture    Facture @relation(fields: [factureId], references: [id], onDelete: Cascade)
  demandePar User    @relation("DemandeurSuppFacture", fields: [demandeParId], references: [id])
  traitePar  User?   @relation("TraiteurSuppFacture", fields: [traiteParId], references: [id])

  @@index([factureId])
  @@index([statut])
  @@map("demandes_suppression_facture")
}

model Paiement {
  id        String          @id @default(cuid())
  factureId String          @map("facture_id")
  montant   Decimal         @db.Decimal(12, 2)
  methode   MethodePaiement
  date      DateTime        @default(now())
  reference String?
  valide    Boolean         @default(false)
  creeLe    DateTime        @default(now()) @map("cree_le")

  facture Facture @relation(fields: [factureId], references: [id], onDelete: Cascade)

  @@index([factureId])
  @@map("paiements")
}

model DocumentGED {
  id             String            @id @default(cuid())
  dossierId      String            @map("dossier_id")
  categorie      CategorieDocument
  nomFichier     String            @map("nom_fichier")
  cheminStockage String            @map("chemin_stockage")
  mimeType       String?           @map("mime_type")
  tailleOctets   Int?              @map("taille_octets")
  uploadeParId   String            @map("uploade_par_id")
  creeLe         DateTime          @default(now()) @map("cree_le")

  dossier    Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  uploadePar User    @relation(fields: [uploadeParId], references: [id])

  @@index([dossierId])
  @@map("documents_ged")
}

model TacheLogistique {
  id         String             @id @default(cuid())
  dossierId  String             @map("dossier_id")
  type       TypeTacheLogistique
  titre      String
  statut     StatutTache        @default(A_FAIRE)
  assigneAId String?            @map("assigne_a_id")
  echeance   DateTime?
  notes      String?
  historique Json?
  creeLe     DateTime           @default(now()) @map("cree_le")
  majLe      DateTime           @updatedAt @map("maj_le")

  dossier  Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  assigneA User?   @relation(fields: [assigneAId], references: [id])

  @@index([dossierId])
  @@map("taches_logistique")
}

model AuditLog {
  id             String   @id @default(cuid())
  timestamp      DateTime @default(now())
  userId         String?  @map("user_id")
  action         String
  tableCible     String   @map("table_cible")
  recordId       String?  @map("record_id")
  ancienneValeur Json?    @map("ancienne_valeur")
  nouvelleValeur Json?    @map("nouvelle_valeur")
  ip             String?
  userAgent      String?  @map("user_agent")

  user User? @relation(fields: [userId], references: [id])

  @@index([tableCible, recordId])
  @@index([timestamp])
  @@map("audit_logs")
}

model DemandeDeverrouillage {
  id           String               @id @default(cuid())
  dossierId    String               @map("dossier_id")
  demandeParId String               @map("demande_par_id")
  traiteParId  String?              @map("traite_par_id")
  motif        String
  statut       StatutDeverrouillage @default(EN_ATTENTE)
  expireLe     DateTime?            @map("expire_le")
  creeLe       DateTime             @default(now()) @map("cree_le")
  traiteLe     DateTime?            @map("traite_le")

  dossier    Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  demandePar User    @relation("Demandeur", fields: [demandeParId], references: [id])
  traitePar  User?   @relation("Traiteur", fields: [traiteParId], references: [id])

  @@index([dossierId])
  @@map("demandes_deverrouillage")
}

model Notification {
  id     String   @id @default(cuid())
  userId String   @map("user_id")
  type   String
  lu     Boolean  @default(false)
  titre  String
  payload Json?
  creeLe DateTime @default(now()) @map("cree_le")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lu])
  @@map("notifications")
}

model Communication {
  id         String   @id @default(cuid())
  dossierId  String   @map("dossier_id")
  canal      String   // EMAIL | WHATSAPP | INTERNE | APPEL
  sens       String   @default("SORTANT") // ENTRANT | SORTANT
  sujet      String?
  corps      String
  auteurId   String?  @map("auteur_id")
  auteurNom  String?  @map("auteur_nom")
  creeLe     DateTime @default(now()) @map("cree_le")

  dossier Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)
  auteur  User?   @relation(fields: [auteurId], references: [id])

  @@index([dossierId])
  @@map("communications")
}

model InboxMessage {
  id        String   @id @default(cuid())
  canal     String   // EMAIL | WHATSAPP
  fromAddr  String   @map("from_addr")
  sujet     String?
  corps     String
  dossierId String?  @map("dossier_id")
  lu        Boolean  @default(false)
  creeLe    DateTime @default(now()) @map("cree_le")

  @@index([lu])
  @@map("inbox_messages")
}

model AppVersion {
  id             String   @id @default(cuid())
  version        String   @unique
  changelog      String?
  driveUrl       String?  @map("drive_url")
  downloadUrlMac String?  @map("download_url_mac")
  downloadUrlWin String?  @map("download_url_win")
  /// Signature minisign du bundle updater mac (.app.tar.gz.sig)
  updaterMacSig  String?  @map("updater_mac_sig") @db.Text
  /// Signature minisign du bundle updater Windows (.exe.sig)
  updaterWinSig  String?  @map("updater_win_sig") @db.Text
  actif          Boolean  @default(true)
  creeLe         DateTime @default(now()) @map("cree_le")

  @@map("app_versions")
}
