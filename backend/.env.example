# =============================================================================
# eXpert API — variables d'environnement
# Local : cp .env.example .env
# Railway : service backend → Variables (NE PAS committer .env)
# =============================================================================

# --- OBLIGATOIRE sur Railway ---
# Service backend : Add Reference → Postgres → DATABASE_URL
# (sur Railway, la ref interne postgres.railway.internal est OK)
#
# Depuis ton Mac (prisma seed / migrate) : utilise l’URL PUBLIQUE
# Railway → Postgres → Connect → Public network → DATABASE_PUBLIC_URL
# Host typique : XXXX.proxy.rlwy.net — JAMAIS postgres.railway.internal en local
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/railway?schema=public

# Mot de passe du Super Admin créé / mis à jour par `pnpm prisma:seed`
# (obligatoire pour le seed — ne jamais committer la vraie valeur)
SEED_ADMIN_PASSWORD=

# Redis (optionnel MVP) : ${{Redis.REDIS_URL}}
REDIS_URL=redis://default:PASSWORD@HOST:PORT

# JWT — secrets longs et uniques en production (génère avec openssl rand -hex 32)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# App — sur Railway, PORT est injecté automatiquement (ne force pas 3000)
PORT=3000
NODE_ENV=production
APP_VERSION=1.0.0
CORS_ORIGINS=http://localhost:1420,tauri://localhost,https://tauri.localhost
DRIVE_DOWNLOAD_URL=https://drive.google.com/drive/folders/REPLACE_WITH_SHARED_FOLDER_ID
UNLOCK_TTL_HOURS=24
SOFT_DELETE_RETENTION_DAYS=90
SOFT_DELETE_NOTIFY_DAYS_BEFORE=7
# Stockage fichiers (photos, GED, PDF, Word…)
# Option A — variables S3_* (manuel)
S3_ENDPOINT=https://t3.storageapi.dev
S3_REGION=auto
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key

# Option B — Railway Bucket « Add to Service » / Variable References :
#   BUCKET=${{assembled-thermos.BUCKET}}
#   ENDPOINT=${{assembled-thermos.ENDPOINT}}
#   ACCESS_KEY_ID=${{assembled-thermos.ACCESS_KEY_ID}}
#   SECRET_ACCESS_KEY=${{assembled-thermos.SECRET_ACCESS_KEY}}
#   REGION=${{assembled-thermos.REGION}}
# (le code accepte aussi ces noms automatiquement)

# Vérif: GET /health → "storage":"s3"
# Fallback disque si aucune var S3 : GED_STORAGE_PATH
GED_STORAGE_PATH=./uploads

# E-mails transactionnels (rappels RDV, etc.) — https://resend.com
RESEND_API_KEY=
RESEND_FROM="eXpert SARLU <noreply@votredomaine.com>"

# Domaines publics expert-evac.com
# verify  → custom domain Railway (pointe vers l’API, route /v/:code)
PUBLIC_VERIFY_BASE_URL=https://verify.expert-evac.com
APP_PUBLIC_URL=https://expertsarlu-production.up.railway.app

# form    → Vercel apps/patient-portal (pré-inscription)
PUBLIC_FORM_BASE_URL=https://form.expert-evac.com
PUBLIC_PATIENT_PORTAL_URL=https://form.expert-evac.com

# patient → Vercel apps/patient-portal (carte de suivi /suivi/:token)
# (même projet Vercel, domaines form + patient)
PUBLIC_SUIVI_BASE_URL=https://patient.expert-evac.com

# CORS (ajouter les 3 sous-domaines)
# CORS_ORIGINS=...,https://form.expert-evac.com,https://patient.expert-evac.com,https://verify.expert-evac.com

# Liens installateurs (remplis auto par GitHub Actions après Desktop release)
# DOWNLOAD_MAC_URL=https://github.com/.../releases/download/v1.0.0/eXpert_...dmg
# DOWNLOAD_WIN_URL=https://github.com/.../releases/download/v1.0.0/eXpert_...exe
DOWNLOAD_MAC_URL=
DOWNLOAD_WIN_URL=
DRIVE_DOWNLOAD_URL=

# Mises à jour desktop (GitHub Actions → /api/version/publish)
GITHUB_REPO=Masala-Software-Company/expertsarlu
RELEASE_SECRET=change-me-long-random-secret
