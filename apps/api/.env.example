# =============================================================================
# eXpert API — variables d'environnement
# Copier vers .env :  cp .env.example .env
# Sur Railway : définir ces variables dans le dashboard (jamais committer .env)
# =============================================================================

# PostgreSQL (Railway Postgres addon → Variables → DATABASE_URL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/railway?schema=public

# Redis (Railway Redis addon ou Upstash — optionnel au démarrage MVP)
REDIS_URL=redis://default:PASSWORD@HOST:PORT

# JWT — générer des secrets longs et uniques en production
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# App
PORT=3000
NODE_ENV=production
APP_VERSION=1.0.0
CORS_ORIGINS=http://localhost:1420,tauri://localhost,https://tauri.localhost
DRIVE_DOWNLOAD_URL=https://drive.google.com/drive/folders/REPLACE_WITH_SHARED_FOLDER_ID
UNLOCK_TTL_HOURS=24
SOFT_DELETE_RETENTION_DAYS=90
SOFT_DELETE_NOTIFY_DAYS_BEFORE=7

# GED (stockage documents — chemin local ou volume Railway)
GED_STORAGE_PATH=./uploads

# Optionnel V2
# WHATSAPP_API_TOKEN=
# SMTP_URL=
