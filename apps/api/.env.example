# Database (PostgreSQL — Railway addon or local docker-compose)
DATABASE_URL=postgresql://expert@127.0.0.1:5432/expert?schema=public

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# App
PORT=3000
NODE_ENV=development
APP_VERSION=1.0.0
CORS_ORIGINS=http://localhost:1420,tauri://localhost,https://tauri.localhost
DRIVE_DOWNLOAD_URL=https://drive.google.com/drive/folders/REPLACE_WITH_SHARED_FOLDER_ID
UNLOCK_TTL_HOURS=24
SOFT_DELETE_RETENTION_DAYS=90
SOFT_DELETE_NOTIFY_DAYS_BEFORE=7

# GED storage (local path or S3-compatible later)
GED_STORAGE_PATH=./uploads

# Optional: WhatsApp / Email (V2)
# WHATSAPP_API_TOKEN=
# SMTP_URL=
