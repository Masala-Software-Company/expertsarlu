{
  "name": "expert-sarlu",
  "private": true,
  "version": "1.0.0",
  "description": "eXpert SARLU — Bureau de Coordination Médicale Internationale",
  "main": "backend/dist/main.js",
  "scripts": {
    "dev": "pnpm --parallel --filter @expert/backend --filter @expert/frontend dev",
    "dev:api": "pnpm --filter @expert/backend dev",
    "dev:frontend": "pnpm --filter @expert/frontend dev",
    "dev:portal": "pnpm --filter @expert/patient-portal dev",
    "dev:db": "bash scripts/dev-db.sh",
    "build": "pnpm --filter @expert/backend build",
    "build:all": "pnpm --filter @expert/backend build && pnpm --filter @expert/frontend build",
    "build:portal": "pnpm --filter @expert/patient-portal build",
    "build:tauri": "pnpm --filter @expert/frontend tauri:build",
    "start": "pnpm --filter @expert/backend start:prod",
    "db:migrate": "pnpm --filter @expert/backend prisma:migrate",
    "db:seed": "pnpm --filter @expert/backend prisma:seed",
    "db:generate": "pnpm --filter @expert/backend prisma:generate"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
